{
  "mcpServers": {
    "// ===== MEMORIA PERSISTENTE =====": {},
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE": "${HOME}/.config/Claude/memory/knowledge-graph.json"
      }
    },
    "knowledge-graph": {
      "command": "npx",
      "args": ["-y", "mcp-knowledge-graph"],
      "env": {
        "GRAPH_PATH": "${HOME}/.config/Claude/memory/graph.json"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },

    "// ===== GOOGLE CLOUD =====": {},
    "firebase": {
      "command": "npx",
      "args": ["-y", "firebase-tools@latest", "experimental:mcp"],
      "env": {
        "FIREBASE_PROJECT": "${GCP_PROJECT_ID}"
      }
    },
    "google-cloud-storage": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-gcs"],
      "env": {
        "GCP_PROJECT_ID": "${GCP_PROJECT_ID}",
        "GCS_BUCKET": "${GCP_PROJECT_ID}-claudio-storage"
      }
    },
    "google-drive": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-gdrive"],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}"
      }
    },
    "google-calendar": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-google-calendar"],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}"
      }
    },

    "// ===== MULTI-AI =====": {},
    "chatgpt": {
      "command": "npx",
      "args": ["-y", "claude-chatgpt-mcp"]
    },
    "openai": {
      "command": "npx",
      "args": ["-y", "mcp-openai"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
    },

    "// ===== PRODUCTIVIDAD =====": {},
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${NOTION_TOKEN}\", \"Notion-Version\": \"2022-06-28\"}"
      }
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "asana": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-asana"],
      "env": {
        "ASANA_ACCESS_TOKEN": "${ASANA_ACCESS_TOKEN}"
      }
    },

    "// ===== AUTOMATIZACIÓN =====": {},
    "zapier": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-zapier"],
      "env": {
        "ZAPIER_API_KEY": "${ZAPIER_API_KEY}"
      }
    },

    "// ===== ARCHIVOS =====": {},
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-filesystem", "/home/user/claudio", "/home/user"]
    },

    "// ===== BÚSQUEDA =====": {},
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },

    "// ===== UTILIDADES =====": {},
    "time": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-time"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-fetch"]
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-puppeteer"]
    }
  },
  "globalShortcut": "Ctrl+Shift+Space"
}
