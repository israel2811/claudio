# ============================================================================
# CLAUDIO - Variables de Entorno COMPLETAS
# Copia este archivo como .env y configura tus valores
# cp config/.env.example config/.env
# ============================================================================

# ============================================================================
# GOOGLE CLOUD (PRINCIPAL)
# ============================================================================
GCP_PROJECT_ID=tu-proyecto-id
GCP_REGION=us-central1
GCP_VERTEX_REGION=global
GCP_STORAGE_BUCKET=tu-proyecto-id-claudio-storage

# Google OAuth (para Drive, Calendar, etc.)
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# ============================================================================
# CLAUDE CODE (Vertex AI)
# ============================================================================
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION=global
ANTHROPIC_VERTEX_PROJECT_ID=tu-proyecto-id
# ANTHROPIC_MODEL=claude-opus-4-5@20251101
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5@20251001
# DISABLE_PROMPT_CACHING=1

# ============================================================================
# MULTI-AI (ChatGPT, Codex, Jules)
# ============================================================================
# OpenAI (para ChatGPT y Codex)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jules (Google AI Coding Agent)
# Se genera desde Antigravity o Google Cloud Console
JULES_API_KEY=

# ============================================================================
# PRODUCTIVIDAD
# ============================================================================
# Notion
# Obtener en: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Slack
# Crear app en: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_TEAM_ID=T0XXXXXXX

# Linear
# Obtener en: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Asana
# Obtener en: https://app.asana.com/0/developer-console
ASANA_ACCESS_TOKEN=1/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# AUTOMATIZACIÓN
# ============================================================================
# Zapier
# Obtener en: https://zapier.com/app/developer
ZAPIER_API_KEY=

# n8n (self-hosted)
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# ============================================================================
# DESARROLLO
# ============================================================================
# GitHub
# Obtener en: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitLab
# Obtener en: https://gitlab.com/-/profile/personal_access_tokens
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel
# Obtener en: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ============================================================================
# BASES DE DATOS
# ============================================================================
# PostgreSQL
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/mydb

# Supabase
# Obtener en: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Redis
REDIS_URL=redis://localhost:6379

# ============================================================================
# BÚSQUEDA
# ============================================================================
# Brave Search
# Obtener en: https://brave.com/search/api/
BRAVE_API_KEY=

# Exa (neural search)
# Obtener en: https://exa.ai/
EXA_API_KEY=

# ============================================================================
# PAGOS
# ============================================================================
# Stripe
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PayPal
# Obtener en: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================================================
# ANTIGRAVITY
# ============================================================================
ANTIGRAVITY_DEFAULT_MODEL=gemini-3-pro
# Para usar Claude Opus 4.5 en Antigravity
ANTIGRAVITY_CLAUDE_MODEL=claude-opus-4-5-thinking

# ============================================================================
# OPENCODE
# ============================================================================
# Si usas Antigravity OAuth para OpenCode
OPENCODE_ANTIGRAVITY_AUTH=true
# Modelo preferido para OpenCode
OPENCODE_DEFAULT_MODEL=claude-opus-4-5
